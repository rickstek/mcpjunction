---
import Base from '../../layouts/Base.astro';
import ServerBadges from '../../components/ServerBadges.astro';
import dataset from '../../../public/data/mcp_servers.json';
import categoriesFile from '../../../categories.json';
import topicsFile from '../../../topics.json';
import { fmt } from '../../lib/format';

export async function getStaticPaths() {
  return dataset.servers.map((s: any) => ({
    params: { id: s.id },
    props: { server: s },
  }));
}

// Repo names are not unique across owners: 39 names cover 118 active servers
// ("mcp" alone is used by 20). Where a name collides the title carries the
// owner as a disambiguator — near-duplicate titles across a hundred pages are
// a liability, and the SERP needs to tell them apart too. Computed once at
// module scope, not per page.
const duplicateNames = (() => {
  const seen = new Map<string, number>();
  for (const s of dataset.servers as any[]) {
    if (s.status !== 'active') continue;
    const k = s.name.toLowerCase();
    seen.set(k, (seen.get(k) || 0) + 1);
  }
  return new Set([...seen].filter(([, n]) => n > 1).map(([k]) => k));
})();

const { server } = Astro.props;

const categoryMeta = categoriesFile.categories.find((c: any) => c.slug === server.category);
const categoryName = categoryMeta ? categoryMeta.name : server.category;

const canonicalPath = `/servers/${server.id}`;
const canonicalUrl = new URL(canonicalPath, Astro.site).toString().replace(/\/$/, '');
const datasetUrl = 'https://mcpjunction.ai/data/mcp_servers.json';

const isDelisted = server.status === 'archived_or_removed';

// Repository topics as published by the owner. Third-party strings: a tag
// links to /topics/<tag> only when it is in the approved list (topics.json,
// human-owned); everything else stays plain text, so no unvetted string ever
// becomes a URL on this site.
const topics: string[] = Array.isArray(server.topics) ? server.topics : [];
const approvedTopics = new Set<string>(topicsFile.topics);

// Nobody searches "playwright-mcp"; they search "playwright mcp server". The
// phrase belongs in the title and the H1. Names that already carry it (every
// "mcp-server-*" repo) must not get it twice.
const searchLabel = /mcp[-_ ]?server/i.test(server.name)
  ? server.name
  : `${server.name} MCP Server`;

const titleSubject = duplicateNames.has(server.name.toLowerCase())
  ? `${searchLabel} by ${server.owner}`
  : searchLabel;
// Google truncates around 60 characters and the brand suffix is the least
// useful part of the string, so drop it rather than let it be cut mid-word.
const fullTitle = `${titleSubject} — ${categoryName} | MCP Junction`;
const pageTitle = fullTitle.length > 65 ? `${titleSubject} — ${categoryName}` : fullTitle;

// Human-written summary from editorial/summaries.md (empty for most servers).
// When present it becomes the meta/JSON-LD description: it is our own unique
// prose, whereas the GitHub description is third-party text repeated verbatim
// across every directory that lists this repo.
const summary: string = server.editorial_summary || '';
const metaDescription = summary
  || server.description
  || `${server.full_name} — MCP server listed in the MCP Junction directory.`;

// JSON-LD SoftwareApplication (Rule: extensionless canonical, absolute URLs).
//
// Deliberately NO aggregateRating. Synthesising a rating out of star counts
// would be fabricated review data and risks a manual action; the star
// snippet is not worth that.
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: server.name,
  description: metaDescription,
  url: canonicalUrl,
  codeRepository: server.repo_url,
  // Google matches applicationCategory against a controlled vocabulary, so
  // the schema.org term goes here and our own taxonomy name — which was
  // sitting in this field as free text — moves to the subcategory.
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: categoryName,
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  // Without `offers` the markup is ineligible for Google's software rich
  // result. price 0 is truthful for a public source repository: it is a
  // statement about obtaining the code, not about any hosted service the
  // server may talk to.
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: {
    '@type': 'Organization',
    name: server.owner,
    url: `https://github.com/${server.owner}`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'MCP Junction',
    url: 'https://mcpjunction.ai/',
  },
  dateModified: server.pushed_at,
};
if (server.created_at) jsonLd.datePublished = server.created_at;
if (server.language) jsonLd.programmingLanguage = server.language;
if (server.license) jsonLd.license = server.license;
if (topics.length) jsonLd.keywords = topics.join(', ');

// Replaces the double-hyphen slug in the SERP with a readable trail. The
// visible breadcrumb below renders the same three levels, in the same order —
// Google expects the markup to describe what the page actually shows. The
// final crumb carries no `item`: it is the current page.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mcpjunction.ai/' },
    { '@type': 'ListItem', position: 2, name: 'Categories', item: 'https://mcpjunction.ai/categories' },
    {
      '@type': 'ListItem',
      position: 3,
      name: categoryName,
      item: `https://mcpjunction.ai/categories/${server.category}`,
    },
    { '@type': 'ListItem', position: 4, name: server.name },
  ],
};

// Human-readable last-updated (envelope-level generation timestamp).
const generatedAt = (dataset as any).generated_at;

// Related servers: same category, nearest by star count. Star-proximity
// (not top-N) so each page links a DIFFERENT neighborhood — a mesh, not a
// hub-and-spoke to the same five giants. Pure build-time arithmetic on the
// dataset; no inference (Standing Rule: automation derives nothing editorial).
const related = (() => {
  if (server.status !== 'active') return [];
  const peers = dataset.servers
    .filter((s: any) => s.status === 'active' && s.category === server.category && s.id !== server.id)
    .sort((a: any, b: any) => (b.stars || 0) - (a.stars || 0));
  if (peers.length <= 5) return peers;
  // Index where this server would sit in the star ranking, then take the
  // window of 5 around it (clamped to the ends).
  let idx = peers.findIndex((s: any) => (s.stars || 0) <= (server.stars || 0));
  if (idx === -1) idx = peers.length;
  const start = Math.max(0, Math.min(idx - 2, peers.length - 5));
  return peers.slice(start, start + 5);
})();
---
<Base
  title={pageTitle}
  description={metaDescription}
  canonical={canonicalPath}
  noindex={isDelisted}
  jsonLd={[jsonLd, breadcrumbLd]}
  markdownHref={`/servers/${server.id}.md`}
>
<p class="meta"><a href="/">Home</a> / <a href="/categories">Categories</a> / <a href={`/categories/${server.category}`}>{categoryName}</a></p>

<h1>
  {searchLabel}
  <ServerBadges
    securityReviewed={server.security_reviewed}
    sponsorTier={server.sponsor_tier}
    status={server.status}
  />
</h1>
<p class="tag">by <a href={`https://github.com/${server.owner}`} rel="external nofollow">{server.owner}</a></p>

{isDelisted && (
  <p class="notice-delisted">
    <strong>Delisted notice:</strong> this repository has been archived or
    removed from GitHub since <code>{server.delisted_at}</code>. This page
    remains available for a 30-day grace window so existing citations don't
    break. After that it will 404. Contact <a href="mailto:licensing@mcpjunction.ai">licensing@mcpjunction.ai</a> for corrections.
  </p>
)}

{summary && (
  <>
    <h2>Our summary</h2>
    <p>{summary}</p>
    {/* No byline. The two disclosures below stay because they do real work:
        independence from sponsorship is the FTC posture, and "not a security
        review" keeps this field from being mistaken for the reviewed badge,
        which is set only by hand. */}
    <p class="meta">Independent of any sponsorship — see our
    <a href="/licensing#editorial-independence">editorial independence policy</a>.
    A summary is not a security review.</p>
  </>
)}

<h2>Description from the repository</h2>
<p>{server.description || <em>No description provided.</em>}</p>
<p class="meta">Description imported from public GitHub repository metadata (<a href={server.repo_url} rel="external nofollow">{server.full_name}</a>). MCP Junction does not author or curate descriptions.</p>

<h2>At a glance</h2>
<table>
  <tr><th>Category</th><td><a href={`/categories/${server.category}`}>{categoryName}</a></td></tr>
  <tr><th>Language</th><td>{server.language || <em>unspecified</em>}</td></tr>
  <tr><th>License</th><td>{server.license || <em>unspecified</em>}</td></tr>
  <tr><th>Stars</th><td>{fmt(server.stars)}</td></tr>
  <tr><th>Forks</th><td>{fmt(server.forks)}</td></tr>
  <tr><th>Open issues</th><td>{server.open_issues}</td></tr>
  <tr><th>Last pushed</th><td>{server.pushed_at}</td></tr>
  <tr><th>Repository</th><td><a href={server.repo_url} rel="external nofollow">{server.repo_url}</a></td></tr>
  {server.homepage && <tr><th>Homepage</th><td><a href={server.homepage} rel="external nofollow">{server.homepage}</a></td></tr>}
</table>

{topics.length > 0 && (
  <>
    <h2>Topics</h2>
    {/* A list, not adjacent spans. Adjacent inline elements carry no text
        node between them, so every text extractor — and every agent reading
        this page as prose — sees "mcpplaywright" as a single token. */}
    <ul class="topics">{topics.map((t) => (
      <li class="topic">{approvedTopics.has(String(t).toLowerCase())
        ? <a href={`/topics/${String(t).toLowerCase()}`}>{t}</a>
        : t}</li>
    ))}</ul>
    <p class="meta">Repository topics as published by the owner on GitHub. Imported verbatim; MCP Junction does not assign or curate them. Linked topics lead to other servers sharing the tag.</p>
  </>
)}

{server.install_hint && (
  <>
    <h2>Install hint</h2>
    <pre class="block"><code>{server.install_hint}</code></pre>
    <p class="meta">Best-effort hint inferred from the repository language. Never
    includes auto-confirm flags (<code>-y</code>, <code>--yes</code>) — the
    package registry name may be squatted by someone other than the repo
    owner. Verify against the repository's own README before running.</p>
  </>
)}

{related.length > 0 && (
  <>
    <h2>Related servers in {categoryName}</h2>
    <ul class="servers">
      {related.map((s: any) => (
        <li>
          <a href={`/servers/${s.id}`}><strong>{s.name}</strong></a>
          <span class="meta"> — {s.owner} · ★ {fmt(s.stars)}</span>
          {s.description && <div class="meta">{s.description}</div>}
        </li>
      ))}
    </ul>
  </>
)}

<h2>Cite this entry</h2>
<table>
  <tr><th>Canonical page</th><td><a href={canonicalUrl}>{canonicalUrl}</a></td></tr>
  <tr><th>Dataset (JSON)</th><td><a href={datasetUrl}>{datasetUrl}</a></td></tr>
  <tr><th>Dataset generated</th><td>{generatedAt}</td></tr>
  <tr><th>Attribution</th><td>via mcpjunction.ai</td></tr>
  {/* Server pages are where agents actually land — far more often than the
      homepage or llms.txt, which are the only other places /mcp is named. */}
  <tr><th>Query from an agent</th><td><code>POST https://mcpjunction.ai/mcp</code> — this directory as an MCP server (streamable HTTP, no auth); tools <code>search_servers</code>, <code>get_server</code>, <code>list_categories</code></td></tr>
  <tr><th>This page as markdown</th><td><a href={`/servers/${server.id}.md`}>{canonicalUrl}.md</a> — or send <code>Accept: text/markdown</code> to the canonical URL</td></tr>
</table>
<p class="meta">Directory content is licensed per <a href="/licensing">/licensing</a>. Bulk retrieval and AI training require a paid license.</p>
</Base>
