---
import Base from '../../layouts/Base.astro';
import dataset from '../../../public/data/mcp_servers.json';
import categoriesFile from '../../../categories.json';

const activeServers = dataset.servers.filter((s: any) => s.status === 'active');
const counts: Record<string, number> = {};
for (const s of activeServers) counts[s.category] = (counts[s.category] || 0) + 1;

// File order in categories.json is match precedence — first match wins in
// scripts/pipeline.py — which is an implementation detail, not a reading
// order. Adding a category ahead of the ai-* family to fix what it captures
// also moved it to the middle of this list, for no reason a visitor can see.
// Display order is therefore explicit: an optional "order" number first,
// then alphabetically by name, matching how llms.txt already lists them.
// uncategorized is a holding pen rather than a subject, so it sorts last
// whatever its number.
//
// Compared by code unit, not localeCompare: the order has to be identical in
// CI and on a developer's machine, the same reason src/lib/format.ts exists.
const orderRank = (c: any) =>
  c.slug === 'uncategorized' ? 2 : typeof c.order === 'number' ? 0 : 1;

const categories = categoriesFile.categories
  .map((c: any) => ({ ...c, count: counts[c.slug] || 0 }))
  .sort((a: any, b: any) =>
    orderRank(a) - orderRank(b) ||
    (a.order ?? 0) - (b.order ?? 0) ||
    (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));

// The ItemList is a declaration of what we want indexed, so a category held
// out of the index (uncategorized) is held out of the list too. It stays
// linked in the visible list below — reachable for people and agents.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'MCP Server Categories — MCP Junction',
    description: 'Model Context Protocol servers grouped by category.',
    url: 'https://mcpjunction.ai/categories',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: categories
        .filter((c: any) => c.noindex !== true)
        .map((c: any, i: number) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: `https://mcpjunction.ai/categories/${c.slug}`,
          name: c.name,
        })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mcpjunction.ai/' },
      { '@type': 'ListItem', position: 2, name: 'Categories' },
    ],
  },
];
---
<Base
  title="MCP Server Categories — MCP Junction"
  description="Browse MCP servers by category — AI Agents, AI Coding Assistants, Databases, Search, and more."
  canonical="/categories"
  jsonLd={jsonLd}
>
<p class="meta"><a href="/">Home</a> / Categories</p>
<h1>MCP Server Categories</h1>
<p>{categories.length} categories, {activeServers.length} MCP servers total.</p>

<ul class="servers">
  {categories.map((c) => (
    <li>
      <a href={`/categories/${c.slug}`}><strong>{c.name}</strong></a>
      <span class="meta"> — {c.count} server{c.count === 1 ? '' : 's'}</span>
      <div class="meta">{c.description}</div>
    </li>
  ))}
</ul>
</Base>
