---
import Base from '../../layouts/Base.astro';
import ServerBadges from '../../components/ServerBadges.astro';
import dataset from '../../../public/data/mcp_servers.json';
import categoriesFile from '../../../categories.json';
import { fmt } from '../../lib/format';

export async function getStaticPaths() {
  return categoriesFile.categories.map((c: any) => ({
    params: { slug: c.slug },
    props: { category: c },
  }));
}

const { category } = Astro.props;

const members = dataset.servers
  .filter((s: any) => s.status === 'active' && s.category === category.slug)
  .sort((a: any, b: any) => (b.stars || 0) - (a.stars || 0));

const canonicalPath = `/categories/${category.slug}`;
const canonicalUrl = new URL(canonicalPath, Astro.site).toString().replace(/\/$/, '');
const generatedAt = (dataset as any).generated_at;

// A holding pen, not a browsable subject: keep it reachable for people and
// agents, keep it out of the index and the sitemap. Flag lives in
// categories.json so the taxonomy stays human-owned in one place.
const noindex = category.noindex === true;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category.name} — MCP Junction`,
  description: category.description,
  url: canonicalUrl,
  dateModified: generatedAt,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: members.length,
    itemListElement: members.map((s: any, i: number) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/servers/${s.id}`, Astro.site).toString().replace(/\/$/, ''),
      name: s.name,
    })),
  },
};

// Mirrors the visible trail below. The final crumb carries no `item`: it is
// the current page.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mcpjunction.ai/' },
    { '@type': 'ListItem', position: 2, name: 'Categories', item: 'https://mcpjunction.ai/categories' },
    { '@type': 'ListItem', position: 3, name: category.name },
  ],
};
---
<Base
  title={`${category.name} MCP Servers — MCP Junction`}
  description={category.description}
  canonical={canonicalPath}
  noindex={noindex}
  jsonLd={[jsonLd, breadcrumbLd]}
  markdownHref={`/categories/${category.slug}.md`}
>
<p class="meta"><a href="/">Home</a> / <a href="/categories">Categories</a></p>
{/* Same reasoning as the server-page H1: the query is "browser automation
    mcp servers", not "browser automation". */}
<h1>{category.name} MCP Servers</h1>
<p>{category.description}</p>
<p class="meta">{members.length} server{members.length === 1 ? '' : 's'} · updated {generatedAt}</p>

{members.length === 0 ? (
  <p><em>No servers currently listed in this category. The nightly refresh picks up new servers as they appear on GitHub.</em></p>
) : (
  <ul class="servers">
    {members.map((s: any) => (
      <li>
        <a href={`/servers/${s.id}`}><strong>{s.name}</strong></a>
        <span class="meta"> — {s.owner} · {s.language || 'unknown language'} · ★ {fmt(s.stars)}</span>
        <ServerBadges
          securityReviewed={s.security_reviewed}
          sponsorTier={s.sponsor_tier}
          status={s.status}
        />
        {s.description && <div class="meta">{s.description}</div>}
      </li>
    ))}
  </ul>
)}
</Base>
