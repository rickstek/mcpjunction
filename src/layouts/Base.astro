---
export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: unknown;
  /** Path to this page's markdown variant, if one is emitted. */
  markdownHref?: string;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  jsonLd,
  markdownHref,
} = Astro.props;

// Extensionless, no trailing slash — except the site root, which is
// canonically "https://mcpjunction.ai/" (matches the sitemap entry).
function toCanonical(path: string): string {
  const url = new URL(path, Astro.site).toString();
  const stripped = url.replace(/\/$/, '');
  return stripped === 'https://mcpjunction.ai' ? stripped + '/' : stripped;
}
const canonicalHref = toCanonical(
  canonical ?? (Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/'),
);
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
{description && <meta name="description" content={description}>}
<link rel="canonical" href={canonicalHref}>
<link rel="license" type="application/rsl+xml" href="/license.xml">
{/* Standards-based discovery of the markdown variant. Works even if the
    Worker's Accept-header negotiation is ever turned off. */}
{markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref}>}
{noindex && <meta name="robots" content="noindex">}
<meta property="og:type" content="website">
<meta property="og:site_name" content="MCP Junction">
<meta property="og:title" content={title}>
{description && <meta property="og:description" content={description}>}
<meta property="og:url" content={canonicalHref}>
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content={title}>
{description && <meta name="twitter:description" content={description}>}
<!-- is:global is REQUIRED, not stylistic. Astro scopes <style> to the component
     it is declared in, and slotted page content does not carry this layout's
     scope attribute — so every scoped rule below (h1, table, .badge, .meta…)
     silently applied to nothing. Keep is:global on this block. -->
<style is:global>
:root {
  color-scheme: light dark;
  --bg: #ffffff;
  --fg: #1a1a2e;
  --muted: #5b6b8c;
  --muted-2: #666666;
  --link: #1f4e79;
  --border: #cccccc;
  --rule: #dddddd;
  --rule-soft: #eeeeee;
  --surface: #f2f2f7;
  --badge-reviewed-bg: #d4edda;
  --badge-reviewed-fg: #155724;
  --badge-sponsored-bg: #fff3cd;
  --badge-sponsored-fg: #856404;
  --badge-delisted-bg: #f8d7da;
  --badge-delisted-fg: #721c24;
  --notice-bg: #f8d7da;
  --notice-border: #f5c6cb;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #12121a;
    --fg: #e9e9f0;
    --muted: #a9b2c9;
    --muted-2: #a0a0b0;
    --link: #8ab8e8;
    --border: #3c3c4c;
    --rule: #2f2f3d;
    --rule-soft: #262632;
    --surface: #1e1e2a;
    --badge-reviewed-bg: #14331f;
    --badge-reviewed-fg: #8fe3a8;
    --badge-sponsored-bg: #3a2e0c;
    --badge-sponsored-fg: #f0c86a;
    --badge-delisted-bg: #3d1519;
    --badge-delisted-fg: #f4a4ac;
    --notice-bg: #33151a;
    --notice-border: #5c2129;
  }
}
body {
  font-family: Georgia, serif;
  max-width: 780px;
  margin: 6vh auto;
  padding: 0 24px;
  background: var(--bg);
  color: var(--fg);
  line-height: 1.6;
}
h1 { font-size: 1.9rem; margin-bottom: .2rem; }
h2 { font-size: 1.3rem; margin-top: 2rem; }
.tag { color: var(--muted); font-style: italic; }
a { color: var(--link); }
nav.site { margin: 1rem 0 2rem; font-size: .95rem; }
nav.site a { margin-right: 1.25rem; }
table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
td, th {
  border: 1px solid var(--border);
  padding: 8px;
  text-align: left;
  font-size: .95rem;
  /* `anywhere`, not `break-word`: only `anywhere` feeds back into the table's
     min-content width, so a bare canonical URL in a cell stops forcing the
     whole document wider than a phone screen. */
  overflow-wrap: anywhere;
}
th { background: var(--surface); }
code { background: var(--surface); padding: 2px 6px; border-radius: 4px; font-size: .9em; }
pre.block {
  background: var(--surface);
  padding: .75rem;
  border-radius: 4px;
  overflow-x: auto;
}
pre.block code { background: none; padding: 0; }
pre.cite { white-space: pre-wrap; }
ul.servers { list-style: none; padding: 0; }
ul.servers li { padding: .75rem 0; border-bottom: 1px solid var(--rule-soft); }
.meta { color: var(--muted-2); font-size: .9rem; }
ul.topics {
  list-style: none;
  padding: 0;
  margin: 1rem 0 .25rem;
  display: flex;
  flex-wrap: wrap;
  gap: .4rem;
}
.topic {
  padding: 2px 10px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface);
  font-size: .8rem;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}
.badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 3px;
  font-size: .75rem;
  font-weight: bold;
  margin-left: .5rem;
  vertical-align: middle;
}
.badge-reviewed { background: var(--badge-reviewed-bg); color: var(--badge-reviewed-fg); }
.badge-sponsored { background: var(--badge-sponsored-bg); color: var(--badge-sponsored-fg); }
.badge-delisted { background: var(--badge-delisted-bg); color: var(--badge-delisted-fg); }
.badge a { color: inherit; }
.notice-delisted {
  padding: 1rem;
  background: var(--notice-bg);
  border: 1px solid var(--notice-border);
  border-radius: 4px;
}
footer {
  margin-top: 3rem;
  font-size: .85rem;
  color: var(--muted-2);
  border-top: 1px solid var(--rule);
  padding-top: 1rem;
}
</style>
{/* set:html is required for JSON-LD (escaped entities would corrupt the JSON),
    so the payload itself must be made script-safe: descriptions come from
    arbitrary GitHub repos, and a "</script>" inside one would otherwise close
    the tag and inject markup. \u003c is valid JSON and neutralizes it. */}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}></script>}
</head>
<body>
<nav class="site">
  <a href="/">Home</a>
  <a href="/categories">Categories</a>
  <a href="/data">Dataset</a>
  <a href="/licensing">Licensing</a>
</nav>
<slot />
<footer>MCP Junction is an independent directory. Not affiliated with, or
endorsed by, Anthropic or the Model Context Protocol project. Data derived
from public GitHub API metadata; correction and takedown requests honored
promptly via the <a href="/licensing">licensing page</a> contact.</footer>
</body>
</html>
